# @ECLASS: pnpm.eclass
# @SUPPORTED_EAPIS: 8 9
# @BLURB: An eclass for installing pnpm based packages
# @DESCRIPTION:
# An eclass to help maintain pnpm based packages.

if [[ ! ${_PNPM_ECLASS} ]]; then
_PNPM_ECLASS=1
fi

case ${EAPI} in
	8|9) inherit nodejs-utils ;;
	*) die "${ECLASS}: EAPI ${EAPI:-0} not supported" ;;
esac

case ${EAPI} in
	8) inherit edo ;;
esac

if [[ ! ${NODE_OPTIONAL} ]]; then
	BDEPEND="
		>=sys-apps/pnpm-11
		app-misc/jq
		>=app-portage/node-deps-2.12
	"
fi

# @ECLASS_VARIABLE: NODE_OPTIONAL
# @DEFAULT_UNSET
# @PRE_INHERIT
# @DESCRIPTION:
# If set to a non-null value before inherit, the nodejs part of the
# ebuild will be considered optional. You will need to set BDEPEND and call the
# required functions in your ebuild

# @ECLASS_VARIABLE: NODE_URIS
# @DEFAULT_UNSET
# @DESCRIPTION:
# A SRC_URI compatible list of URIs generated by `node-deps uris` or otherwise.
# It is then included in the SRC_URI list.
#
# If you have defined this variable, you will need to also define a src_unpack
# function to unpack your sources independently of the ${A} variable. Don't use
# `default` in your src_unpack function!
# Example:
# @CODE
# NODE_URIS="
# 	lots
# 	and
# 	lots
# 	of
# 	uris
# "
# SRC_URI="
# 	https://github.com/$user/${PN}/archive/v${PV}.tar.gz -> ${P}.tar.gz
# 	${NODE_URIS}
# "
# src_unpack() {
# 	unpack "${P}.tar.gz"
# }
# @CODE

# @ECLASS_VARIABLE: NODE_WRAPPER_OPT
# @DEFAULT_UNSET
# @DESCRIPTION:
# An array variable containing options to append to the wrapper script
# See https://nodejs.org/api/cli.html for a complete list of options
# Example:
# @CODE
# NODE_WRAPPER_OPT=("--enable-source-maps" "--use_strict")
# @CODE

# @ECLASS_VARIABLE: NO_NODE_MODULES
# @DEFAULT_UNSET
# @DESCRIPTION:
# If set to a non-null value, npm_src_install will not install node_modules

# @ECLASS_VARIABLE: PNPM_DEPS_DIR
# @DESCRIPTION:
# Directory where downloaded tarballs are located. This should be ${WORKDIR}/pnpm-deps
# when using a tarball sourced from `node-deps --pm pnpm download --pack`
#
# If you have defined all nodejs source tarballs in SRC_URI, you will need to
# set this variable appropriately (likely to ${DISTDIR})
# Using this method has been discussed and is discourage upstream.
# See https://gitweb.gentoo.org/repo/gentoo.git/commit/eclass/go-module.eclass?id=62fb29
#
# The default value is ${WORKDIR}/pnpm-deps

# @ECLASS_VARIABLE: PNPM_PROJECT_DIR
# @DESCRIPTION:
# Directory where the project's pnpm-lock.yaml is located. If unset, ${S} is
# used

# @ECLASS_VARIABLE: PNPM_BUILD_SCRIPT
# @DEFAULT_UNSET
# @REQUIRED
# @DESCRIPTION:
# The build script to run when `pnpm run` is called. A list can usually be found
# in the package.json file

# @ECLASS_VARIABLE: PNPM_WORKSPACE
# @DEFAULT_UNSET
# @DESCRIPTION:
# The workspace to build and install

# @ECLASS_VARIABLE: PNPM_FLAGS
# @DEFAULT_UNSET
# @DESCRIPTION:
# An array variable containing flags to use during all `pnpm` operations

# @ECLASS_VARIABLE: PNPM_PN
# @DESCRIPTION:
# The package name to use when installing into
# /usr/$(get_libdir)/node_modules/. If unset (the default), the name is read
# from the "name" field in package.json

# @ECLASS_VARIABLE: PNPM_INSTALL_FLAGS
# @DEFAULT_UNSET
# @DESCRIPTION:
# An array variable containing flags to use during `pnpm install`
#
# A note about the "--no-optional" flag:
# Some packages need optional dependencies to figure out which binary to use
# during `pnpm rebuild` in src_configure. This behaviour is caused by the eclass
# running `pnpm install` with "--ignore-scripts". While some systems will get it
# right with the "--no-optional" flag enabled, no-multilib profiles (and
# probably others) will not. Any superfluous packages should be cleaned up with
# `pnpm pack` later anyways.

# @ECLASS_VARIABLE: PNPM_REBUILD_FLAGS
# @DEFAULT_UNSET
# @DESCRIPTION:
# An array variable containing flags to use during `pnpm rebuild`

# @ECLASS_VARIABLE: PNPM_BUILD_FLAGS
# @DEFAULT_UNSET
# @DESCRIPTION:
# An array variable containing flags to use during `pnpm run` (build) operations

# @ECLASS_VARIABLE: PNPM_PACK_FLAGS
# @DEFAULT_UNSET
# @DESCRIPTION:
# An array variable containing flags to use during `pnpm pack` operations

# @ECLASS_VARIABLE: PNPM_PRUNE_FLAGS
# @DEFAULT_UNSET
# @DESCRIPTION:
# An array variable containing flags to use during `pnpm prune` operations

# @ECLASS_VARIABLE: PNPM_NO_PRUNE
# @DEFAULT_UNSET
# @DESCRIPTION:
# Setting to a non-null value will disable `pnpm prune` in the src_install function

# @ECLASS_VARIABLE: PNPM_CACHE_DIR
# @INTERNAL
# @DESCRIPTION:
# Set the default pnpm-cache directory for this script and `node-deps`

# @ECLASS_VARIABLE: PNPM_HTTP_PORT
# @USER_VARIABLE
# @DESCRIPTION:
# Port for the temporary dependency http server. Defaults to 56743
: "${PNPM_HTTP_PORT:=56743}"

# @FUNCTION: pnpm_src_unpack
# @DESCRIPTION:
# Does default unpack then verifies that PNPM_DEPS_DIR exists and that the
# tarballs match the integrity found in pnpm-lock.yaml
pnpm_src_unpack() {
	debug-print-function "${FUNCNAME[0]}" "$@"

	if [[ -n ${NODE_URIS} ]]; then
		die "${FUNCNAME[0]} shouldn't be used when NODE_URIS is defined"
	fi

	default
}

# @FUNCTION: pnpm_src_configure
# @DESCRIPTION:
# Configures pnpm to build with the distributed tarball. This relies `node-deps`
# to modify pnpm-lock.yaml for any git hosted deps and then symlink all deps for
# the web server
pnpm_src_configure() {
	debug-print-function "${FUNCNAME[0]}" "$@"

	export PNPM_PROJECT_DIR="${PNPM_PROJECT_DIR:-"${S}"}"
	local PNPM_DEPS_DIR="${PNPM_DEPS_DIR:-"${WORKDIR}/pnpm-deps"}"
	local PNPM_CACHE_DIR="${WORKDIR}/pnpm-cache"

	ebegin "Generating temporary http server directory"
	edo node-deps cache \
		--pm pnpm \
		--project-dir "${PNPM_PROJECT_DIR}" \
		--deps-dir "${PNPM_DEPS_DIR}" \
		--cache-dir "${PNPM_CACHE_DIR}" \
		--cache-port "${PNPM_HTTP_PORT}"
	eend $?

	ebegin "Starting temporary http server"
	local http_pid errfile
	errfile=$(mktemp)
	python3 -m http.server \
		"${PNPM_HTTP_PORT}" \
		--bind 127.0.0.1 \
		--directory "${PNPM_CACHE_DIR}" \
		>/dev/null 2>"${errfile}" &
	http_pid=$!

	sleep 1

	if ! kill -0 "${http_pid}" 2>/dev/null; then
		# he's dead, jim
		cat "${errfile}"
		rm -f "${errfile}"
		die "http.server failed to start on port ${PNPM_HTTP_PORT}"
	fi

	rm -f "${errfile}"
	trap "kill ${http_pid} 2>/dev/null" EXIT INT TERM
	eend 0

	export pnpm_config_progress="false"
	export pnpm_config_registry="http://127.0.0.1:${PNPM_HTTP_PORT}"
	export pnpm_config_pm_on_fail="ignore"
	# `pnpm install` now hits the internet for security (supply chain, verity
	# etc.) reasons. this means a fully offline build is impossible except by 
	# doing one of the following:
	# 1. pack and distribute the final result of `pnpm install` from a machine
	#    with a compatible version of pnpm and "trustLockfile: false" or
	# 2. run `pnpm install` during src_unpack, bypassing the network sandbox
	#    this is not truly offline in the traditional gentoo sense
	# TODO: maybe fix it
	export pnpm_config_trust_lockfile="true"

	export npm_config_nodedir="/usr/include/node"
	export npm_package_config_node_gyp_nodedir="/usr/include/node"
	npm_config_node_gyp="/usr/$(get_libdir)/node_modules/npm/node_modules/node-gyp/lib/node-gyp.js"
	export npm_config_node_gyp

	einfo "Installing dependencies"
	pnpm config set store-dir "${HOME}/pnpm" || die
	pnpm config set package-import-method clone-or-copy || die
	edo pnpm install \
		--dir "${PNPM_PROJECT_DIR}" \
		--ignore-scripts \
		--frozen-lockfile \
		--network-concurrency 8 \
		"${PNPM_INSTALL_FLAGS[@]}" \
		"${PNPM_FLAGS[@]}"

	# ensure lifecycle scripts are run
	# don't die here. wait for packages to transition away from postinstall
	# scripts, which are no longer allowed by (p)npm
	nonfatal edo pnpm rebuild --dir "${PNPM_PROJECT_DIR}" "${PNPM_REBUILD_FLAGS[@]}" "${PNPM_FLAGS[@]}"
}

# @FUNCTION: pnpm_src_compile
# @DESCRIPTION:
# Runs the `pnpm run` build with all the provided flags
pnpm_src_compile() {
	debug-print-function "${FUNCNAME[0]}" "$@"

	if [[ -z "${PNPM_BUILD_SCRIPT-}" ]]; then
		die "PNPM_BUILD_SCRIPT is not set"
	fi

	edo pnpm run \
		--dir "${PNPM_PROJECT_DIR}" \
		${PNPM_WORKSPACE+--filter "{$PNPM_WORKSPACE}"} \
		"${PNPM_BUILD_SCRIPT}" \
		"${PNPM_BUILD_FLAGS[@]}" \
		"${PNPM_FLAGS[@]}"
}

# @FUNCTION: pnpm_get_destdir
# @DESCRIPTION:
# See nodejs_get_destdir in nodejs-utils.eclass
pnpm_get_destdir() {
	debug-print-function "${FUNCNAME[0]}" "$@"

	nodejs_get_destdir "${PNPM_PN-}" "${PNPM_PROJECT_DIR}"
}

# @FUNCTION: pnpm_src_install
# @DESCRIPTION:
# This src_install function is used to install standalone nodejs applications.
# If you're not building a standalone nodejs application (e.g. web assets), you
# will need to define your own src_install function that installs the completed
# build directory as desired.
#
# Adapted from https://github.com/NixOS/nixpkgs/blob/master/pkgs/build-support/node/build-npm-package/hooks/npm-install-hook.sh
pnpm_src_install() {
	debug-print-function "${FUNCNAME[0]}" "$@"

	local dest_dir
	dest_dir=$(pnpm_get_destdir) || die

	# `pnpm pack` writes to cache so temporarily override it
	local pnpm_json
	pnpm_json=$(pnpm pack \
		--dir "${PNPM_PROJECT_DIR}" \
		--json \
		--dry-run \
		--loglevel warn \
		${PNPM_WORKSPACE+--filter "{$PNPM_WORKSPACE}"} \
		"${PNPM_BUILD_FLAGS[@]}" \
		"${PNPM_FLAGS[@]}"
	)

	local file_list
	file_list=$(jq --raw-output '
		.files |
		map(.path | select(. | startswith("node_modules/") | not)) |
		join("\n")
	' <<< "${pnpm_json}")

	while IFS= read -r file; do
		local dest
		dest=${dest_dir}/$(dirname "${file}")
		insinto "${dest}"
		doins "${PNPM_WORKSPACE-.}/${file}"
	done <<< "${file_list}"

	# if node_modules wasn't generated with `pnpm pack`, prune and copy them
	# from ${S}
	if [[ -z "${NO_NODE_MODULES-}" ]]; then
		if [[ ! -d "${dest_dir}/node_modules" ]]; then
			if [[ -z "${PNPM_NO_PRUNE-}" ]]; then
				edo pnpm prune \
					--dir "${PNPM_PROJECT_DIR}" \
					--prod \
					${NPM_WORKSPACE+--filter "{$PNPM_WORKSPACE}"} \
					"${PNPM_PRUNE_FLAGS[@]}" \
					"${PNPM_FLAGS[@]}"
			fi

			find node_modules -maxdepth 1 -type d -empty -delete

			insinto "${dest_dir}"
			doins -r node_modules
		fi
	fi
}

# @FUNCTION: pnpm_install_bin_wrappers
# @DESCRIPTION:
# See nodejs_install_bin_wrappers in nodejs-utils.eclass
pnpm_install_bin_wrappers() {
	debug-print-function "${FUNCNAME[0]}" "$@"

	local dest_dir
	dest_dir=$(pnpm_get_destdir) || die
	nodejs_install_bin_wrappers "${dest_dir}" "${PNPM_WORKSPACE-.}/package.json"
}

# @FUNCTION: pnpm_install_man
# @DESCRIPTION:
# See nodejs_install_man in nodejs-utils.eclass
pnpm_install_man() {
	debug-print-function "${FUNCNAME[0]}" "$@"

	local dest_dir
	dest_dir=$(pnpm_get_destdir) || die
	nodejs_install_man "${dest_dir}" "${PNPM_WORKSPACE-.}/package.json"
}

if [[ ! ${NODE_OPTIONAL} ]]; then
	EXPORT_FUNCTIONS src_unpack src_configure src_compile src_install
fi
